# ------------------------------------------------------------------------------
# Container version overrides. Update these values and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# OPEN_WEBUI_VERSION=main

# ------------------------------------------------------------------------------
# IP and port binding configuration. These bindings will be exposed to the host.
# ------------------------------------------------------------------------------

# OPEN_WEBUI_PORT=8080

# ------------------------------------------------------------------------------
# Container data volumes. These may be named volumes or a path (absolute or
# relative to the 'docker-compose.yaml' file). Defaults to named volumes.
# ------------------------------------------------------------------------------

# OPEN_WEBUI_DATA_VOLUME=open-webui-data

# ------------------------------------------------------------------------------
# Open WebUI secret key used for JSON Web Token and encryption of sensitive data
# (like OAuth tokens for MCP). Set to a long, randomly generated value.
# ------------------------------------------------------------------------------

WEBUI_SECRET_KEY=
